const __vite__css = "/* ============ 主题系统 ============ */\n\n/* 手动切换主题时使用系统级快照过渡，避免整页颜色瞬间跳变。 */\n::view-transition-group(root),\n::view-transition-old(root),\n::view-transition-new(root) {\n  animation-duration: 280ms;\n  animation-timing-function: cubic-bezier(.22, .61, .36, 1);\n}\n\n::view-transition-old(root) {\n  animation-name: theme-view-old;\n}\n\n::view-transition-new(root) {\n  animation-name: theme-view-new;\n}\n\n@keyframes theme-view-old {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n@keyframes theme-view-new {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n/* 旧版 Chromium 不支持 View Transition 时的轻量回退。 */\nhtml.theme-transitioning body {\n  animation: theme-fallback-wash 320ms cubic-bezier(.22, .61, .36, 1);\n}\n\n@keyframes theme-fallback-wash {\n  from { opacity: .86; }\n  to { opacity: 1; }\n}\n\n/* 全局进度控件：统一成细轨道、主题色填充和轻量圆形滑块。 */\ninput.app-range {\n  --range-progress: 0%;\n  appearance: none;\n  -webkit-appearance: none;\n  height: 24px;\n  border: 0;\n  border-radius: 999px;\n  outline: none;\n  background: linear-gradient(90deg,\n    var(--accent) 0 var(--range-progress),\n    color-mix(in srgb, var(--text-secondary) 20%, transparent) var(--range-progress) 100%) !important;\n  background-size: 100% 4px !important;\n  background-position: center !important;\n  background-repeat: no-repeat !important;\n  cursor: pointer;\n  transition: filter 140ms ease;\n}\n\ninput.app-range:hover { filter: brightness(1.06); }\ninput.app-range:focus-visible { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent); }\ninput.app-range::-webkit-slider-runnable-track { height: 4px; border-radius: 999px; background: transparent; }\ninput.app-range::-webkit-slider-thumb {\n  appearance: none;\n  -webkit-appearance: none;\n  width: 14px;\n  height: 14px;\n  margin-top: -5px;\n  border: 2px solid var(--surface-2);\n  border-radius: 50%;\n  background: var(--accent);\n  box-shadow: 0 1px 4px rgba(15, 23, 42, .24), 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);\n  transition: transform 140ms ease, box-shadow 140ms ease;\n}\ninput.app-range:active::-webkit-slider-thumb {\n  transform: scale(1.12);\n  box-shadow: 0 1px 5px rgba(15, 23, 42, .3), 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent);\n}\ninput.app-range::-moz-range-track { height: 4px; border-radius: 999px; background: color-mix(in srgb, var(--text-secondary) 20%, transparent); }\ninput.app-range::-moz-range-progress { height: 4px; border-radius: 999px; background: var(--accent); }\ninput.app-range::-moz-range-thumb {\n  width: 10px;\n  height: 10px;\n  border: 2px solid var(--surface-2);\n  border-radius: 50%;\n  background: var(--accent);\n  box-shadow: 0 1px 4px rgba(15, 23, 42, .24);\n}\n\n/* 白天主题：浅色、清爽 */\n[data-theme='day'] {\n  --bg-primary: linear-gradient(150deg, #eef1f8 0%, #f5f6fa 50%, #e9edf6 100%);\n  --bg-secondary: #ffffff;\n  --bg-toolbar: #ffffff;\n  --bg-card: #ffffff;\n  --bg-hover: #eef0f5;\n  --text-primary: #1a1a2e;\n  --text-secondary: #6b7280;\n  --border: #e2e5ec;\n  --accent: #4f46e5;\n  --accent-hover: #4338ca;\n  --shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\n  --shadow-card: 0 1px 4px rgba(0, 0, 0, 0.1);\n  --focus-ring: #4f46e5;\n  /* 玻璃拟态：浅底用低 alpha 白高光，避免过曝 */\n  --glass-bg-light: rgba(255, 255, 255, 0.45);\n  --glass-bg-medium: rgba(255, 255, 255, 0.62);\n  --glass-bg: rgba(255, 255, 255, 0.62);\n  --glass-bg-strong: rgba(255, 255, 255, 0.82);\n  --glass-blur: 18px;\n  --glass-border: rgba(255, 255, 255, 0.55);\n  --glass-highlight: inset 0 1px 0 rgba(255, 255, 255, 0.7);\n  --glass-radius: 14px;\n}\n\n/* 夜间主题：深色、护眼 */\n[data-theme='night'] {\n  --bg-primary: linear-gradient(155deg, #0c0e14 0%, #0f1117 50%, #12151d 100%);\n  --bg-secondary: #161922;\n  --bg-toolbar: #1a1e29;\n  --bg-card: #1e222e;\n  --bg-hover: #262b39;\n  --text-primary: #e6e8ec;\n  --text-secondary: #9ca3af;\n  --border: #2a2f3c;\n  --accent: #6366f1;\n  --accent-hover: #818cf8;\n  --shadow: 0 4px 12px rgba(0, 0, 0, 0.4);\n  --shadow-card: 0 2px 6px rgba(0, 0, 0, 0.3);\n  --focus-ring: #818cf8;\n  --glass-bg-light: rgba(26, 30, 41, 0.35);\n  --glass-bg-medium: rgba(26, 30, 41, 0.55);\n  --glass-bg: rgba(26, 30, 41, 0.55);\n  --glass-bg-strong: rgba(22, 25, 34, 0.82);\n  --glass-blur: 18px;\n  --glass-border: rgba(255, 255, 255, 0.08);\n  --glass-highlight: inset 0 1px 0 rgba(255, 255, 255, 0.06);\n  --glass-radius: 14px;\n}\n\n/* ============ 全局基础样式 ============ */\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\n/* ============ 玻璃拟态工具类 ============ */\n/* 半透明 + 背景模糊 + 顶部高光内描边，透出底层壁纸/渐变 */\n.glass {\n  background: var(--glass-bg);\n  backdrop-filter: blur(var(--glass-blur)) saturate(1.1);\n  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.1);\n  border: 1px solid var(--glass-border);\n  box-shadow: var(--shadow), var(--glass-highlight);\n}\n/* 弹窗/顶栏等需要更高可读性的表面 */\n.glass--strong {\n  background: var(--glass-bg-strong);\n}\n/* 不支持 backdrop-filter 时回退到实心表面 */\n@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {\n  .glass { background: var(--bg-card); }\n  .glass--strong { background: var(--bg-toolbar); }\n}\n\nbody {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  font-family: system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;\n  background: var(--bg-primary);\n  color: var(--text-primary);\n  overflow: hidden;\n}\n\n#root {\n  width: 100%;\n  height: 100vh;\n  min-height: 100%;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.app-shell {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  flex: 1;\n  min-height: 0;\n  flex-direction: column;\n  overflow: hidden;\n  isolation: isolate;\n  background: var(--bg-primary);\n}\n\n.app-wallpaper {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  background-position: center;\n  background-repeat: no-repeat;\n  background-size: cover;\n  pointer-events: none;\n  transition: opacity 0.2s ease;\n}\n\n.app-content {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex: 1;\n  min-height: 0;\n  flex-direction: column;\n}\n\n.window-controls {\n  position: absolute;\n  top: 0;\n  right: 0;\n  z-index: 30;\n  display: flex;\n  height: 40px;\n}\n\n.window-control {\n  width: 46px;\n  height: 40px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--text-primary);\n  background: transparent;\n  border: none;\n  border-radius: 0;\n  transition: background 0.15s ease, color 0.15s ease;\n}\n\n.window-control:hover {\n  background: color-mix(in srgb, var(--bg-hover) 72%, transparent);\n}\n\n.window-control-close:hover {\n  color: #fff;\n  background: #e81123;\n}\n\n/* 滚动条美化 */\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n::-webkit-scrollbar-thumb {\n  background: var(--border);\n  border-radius: 5px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--text-secondary);\n}\n\nbutton {\n  font-family: inherit;\n  cursor: pointer;\n}\n\n/* 视频卡片悬浮效果 */\n.video-card:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--shadow);\n  border-color: var(--accent);\n}\n\n/* mock 预览模式提示条 */\n.mock-banner {\n  background: var(--accent);\n  color: #fff;\n  font-size: 12px;\n  text-align: center;\n  padding: 4px 8px;\n  letter-spacing: 0.3px;\n}\n\n.internal-player {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  background: #000;\n  display: flex;\n  flex-direction: column;\n}\n\n.internal-player-topbar {\n  height: 48px;\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 0 14px;\n  background: rgba(12, 14, 20, 0.94);\n  color: #fff;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.12);\n}\n\n.internal-player-title {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 14px;\n}\n\n.internal-player-actions {\n  flex-shrink: 0;\n  display: flex;\n  gap: 8px;\n}\n\n.internal-player-actions button {\n  padding: 7px 12px;\n  color: #fff;\n  background: rgba(255, 255, 255, 0.12);\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  border-radius: 6px;\n}\n\n/* 中间舞台：mpv 原生窗口覆盖于此，未就绪时显示占位 */\n.internal-player-stage {\n  flex: 1;\n  min-height: 0;\n  position: relative;\n  background: #000;\n}\n\n.internal-player-message {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 24px;\n  color: rgba(255, 255, 255, 0.82);\n  text-align: center;\n}\n\n/* ============ 底部播放控制栏（路线 B：React/CSS 自绘，吃主题变量） ============ */\n.player-controls {\n  height: 64px;\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 0 16px;\n  background: var(--glass-bg-strong);\n  backdrop-filter: blur(var(--glass-blur)) saturate(1.1);\n  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.1);\n  border-top: 1px solid var(--glass-border);\n  box-shadow: var(--glass-highlight);\n  color: var(--text-primary);\n}\n\n.player-btn {\n  flex-shrink: 0;\n  width: 40px;\n  height: 40px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 15px;\n  color: #fff;\n  background: var(--accent);\n  border: none;\n  border-radius: 50%;\n  transition: background 0.15s ease;\n}\n.player-btn:hover {\n  background: var(--accent-hover);\n}\n\n.player-time {\n  flex-shrink: 0;\n  font-size: 12px;\n  color: var(--text-secondary);\n  font-variant-numeric: tabular-nums;\n  min-width: 44px;\n  text-align: center;\n}\n\n.player-group {\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.player-icon {\n  font-size: 14px;\n  opacity: 0.85;\n}\n\n/* 进度条：占据剩余空间 */\n.player-seek {\n  flex: 1;\n  min-width: 80px;\n}\n\n.player-volume {\n  width: 90px;\n}\n\n/* range 滑块主题化 */\n.player-seek,\n.player-volume {\n  -webkit-appearance: none;\n  appearance: none;\n  height: 4px;\n  border-radius: 2px;\n  background: var(--border);\n  cursor: pointer;\n}\n.player-seek::-webkit-slider-thumb,\n.player-volume::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  appearance: none;\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  background: var(--accent);\n  border: 2px solid var(--bg-toolbar);\n  box-shadow: var(--shadow-card);\n}\n\n/* 倍速按钮组 */\n.player-speed {\n  gap: 2px;\n}\n.player-speed-btn {\n  padding: 4px 8px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  transition: all 0.15s ease;\n}\n.player-speed-btn:hover {\n  color: var(--text-primary);\n  background: var(--bg-hover);\n}\n.player-speed-btn.active {\n  color: #fff;\n  background: var(--accent);\n}\n\n/* 图标旋转动画（导入中 Loader2） */\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n.spin {\n  animation: spin 0.9s linear infinite;\n}\n\n/* ========================================================================\n   产品视觉层（Cinema / Premium）\n\n   这一层是应用壳层和内容库共用的设计令牌。旧版主题变量仍然保留，\n   这样播放器、阅读器和已有的第三方组件不会失效；下面的变量只把\n   表面、边框和文字统一到同一套更克制的层级。\n   ======================================================================== */\n\n:root {\n  /* Shared typography hierarchy: one emphasis scale across the workspace. */\n  --font-size-page-title: 22px;\n  --font-size-section-title: 15px;\n  --font-size-body: 13px;\n  --font-size-meta: 11px;\n  --weight-page-title: 650;\n  --weight-section-title: 620;\n  --weight-body-emphasis: 600;\n  --weight-body: 400;\n  color-scheme: dark;\n  --font-ui: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',\n    'Microsoft YaHei', sans-serif;\n  --surface-0: #0b0d11;\n  --surface-1: #101319;\n  --surface-2: #151a21;\n  --surface-3: #1b212a;\n  --surface-elevated: #202732;\n  --line-subtle: rgba(255, 255, 255, 0.06);\n  --line-default: rgba(255, 255, 255, 0.1);\n  --line-strong: rgba(255, 255, 255, 0.16);\n  --text-tertiary: #6f7884;\n  --accent-soft: rgba(211, 169, 102, 0.14);\n  --accent-contrast: #17130d;\n  --danger: #dc6f6f;\n  --warning: #d9a74a;\n  --success: #76b994;\n  --radius-xs: 5px;\n  --radius-sm: 8px;\n  --radius-md: 11px;\n  --radius-lg: 14px;\n  --radius-xl: 18px;\n  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.18);\n  --shadow-sm: 0 6px 18px rgba(0, 0, 0, 0.2);\n  --shadow-md: 0 14px 34px rgba(0, 0, 0, 0.28);\n  --shadow-lg: 0 24px 70px rgba(0, 0, 0, 0.38);\n  --focus-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 28%, transparent);\n  --motion-fast: 120ms;\n  --motion-normal: 180ms;\n  --motion-slow: 280ms;\n}\n\n/* 默认夜间主题：墨色底 + 微暖金色强调，突出封面而不抢内容焦点。 */\n[data-theme='night'] {\n  color-scheme: dark;\n  --bg-primary: #0b0d11;\n  --bg-secondary: #101319;\n  --bg-toolbar: rgba(15, 19, 26, 0.9);\n  --bg-card: #161b22;\n  --bg-hover: #202731;\n  --text-primary: #f0f1f3;\n  --text-secondary: #9aa3af;\n  --text-tertiary: #6f7884;\n  --border: rgba(255, 255, 255, 0.09);\n  --accent: #d3a966;\n  --accent-hover: #e3bd83;\n  --accent-soft: rgba(211, 169, 102, 0.14);\n  --accent-contrast: #18130a;\n  --focus-ring: #e3bd83;\n  --shadow: 0 14px 36px rgba(0, 0, 0, 0.3);\n  --shadow-card: 0 5px 16px rgba(0, 0, 0, 0.25);\n  --glass-bg-light: rgba(15, 19, 26, 0.65);\n  --glass-bg-medium: rgba(18, 22, 29, 0.82);\n  --glass-bg: rgba(22, 27, 34, 0.86);\n  --glass-bg-strong: rgba(16, 20, 27, 0.96);\n  --glass-blur: 16px;\n  --glass-border: rgba(255, 255, 255, 0.09);\n  --glass-highlight: inset 0 1px 0 rgba(255, 255, 255, 0.045);\n}\n\n/* 浅色主题也采用同一套层级，只调整明度；其余彩色主题保留原有个性。 */\n[data-theme='day'] {\n  color-scheme: light;\n  --bg-primary: #f3f4f6;\n  --bg-secondary: #f8f9fb;\n  --bg-toolbar: rgba(248, 249, 251, 0.92);\n  --bg-card: #ffffff;\n  --bg-hover: #eceef2;\n  --text-primary: #181b22;\n  --text-secondary: #697180;\n  --text-tertiary: #8b93a1;\n  --border: rgba(24, 27, 34, 0.11);\n  --accent: #a47738;\n  --accent-hover: #89652f;\n  --accent-soft: rgba(164, 119, 56, 0.1);\n  --accent-contrast: #fff;\n  --focus-ring: #a47738;\n  --shadow: 0 12px 30px rgba(25, 31, 43, 0.12);\n  --shadow-card: 0 4px 14px rgba(25, 31, 43, 0.1);\n  --glass-bg-light: rgba(255, 255, 255, 0.7);\n  --glass-bg-medium: rgba(255, 255, 255, 0.84);\n  --glass-bg: rgba(255, 255, 255, 0.9);\n  --glass-bg-strong: rgba(255, 255, 255, 0.97);\n  --glass-blur: 16px;\n  --glass-border: rgba(24, 27, 34, 0.1);\n  --glass-highlight: inset 0 1px 0 rgba(255, 255, 255, 0.92);\n}\n\n/* ========================================================================\n   基础层\n   ======================================================================== */\n\nhtml {\n  width: 100%;\n  height: 100%;\n  min-width: 320px;\n  min-height: 100%;\n  margin: 0;\n  background: var(--bg-primary);\n}\n\nbody {\n  font-family: var(--font-ui);\n  font-size: 14px;\n  line-height: 1.45;\n  letter-spacing: 0.005em;\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n  background: var(--bg-primary);\n  color: var(--text-primary);\n}\n\nbutton,\ninput,\nselect,\ntextarea {\n  font: inherit;\n}\n\nbutton:focus-visible,\ninput:focus-visible,\nselect:focus-visible,\ntextarea:focus-visible,\n[tabindex]:focus-visible {\n  outline: 0;\n  box-shadow: var(--focus-shadow);\n}\n\n::selection {\n  color: var(--accent-contrast);\n  background: var(--accent);\n}\n\n/* 更轻的滚动条，让内容而不是滚动条成为视觉重点。 */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n::-webkit-scrollbar-thumb {\n  min-height: 36px;\n  border: 2px solid transparent;\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--text-secondary) 32%, transparent);\n  background-clip: padding-box;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: color-mix(in srgb, var(--text-secondary) 58%, transparent);\n  background-clip: padding-box;\n}\n\n/* ========================================================================\n   应用壳层\n   这些类既可由新的 App shell 使用，也兼容当前的 header / aside 结构。\n   ======================================================================== */\n\n.app-shell {\n  isolation: isolate;\n  color: var(--text-primary);\n  background: var(--bg-primary);\n}\n\n.app-shell::before {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  content: '';\n  background:\n    radial-gradient(900px 560px at 100% -10%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%),\n    radial-gradient(720px 500px at -12% 115%, color-mix(in srgb, var(--accent) 5%, transparent), transparent 68%);\n}\n\n.app-content {\n  min-width: 0;\n  background: transparent;\n}\n\n/* 无边框窗口的内容必须铺满客户区，避免壳层被浏览器默认布局缩进。 */\n.app-shell,\n.app-content {\n  inset: 0;\n  margin: 0 !important;\n  padding: 0 !important;\n  align-self: stretch;\n}\n\n.app-shell {\n  position: absolute;\n  width: auto;\n  height: auto;\n}\n\n.app-content {\n  position: relative;\n  width: 100%;\n  height: 100%;\n}\n\n.app-topbar,\n.toolbar,\n.content-toolbar {\n  position: relative;\n  z-index: 20;\n  display: flex;\n  align-items: center;\n  min-height: 72px;\n  gap: 10px;\n  padding: 14px 24px;\n  color: var(--text-primary);\n  background: color-mix(in srgb, var(--bg-toolbar) 94%, transparent);\n  border-bottom: 1px solid var(--line-subtle);\n  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.14), var(--glass-highlight);\n  backdrop-filter: blur(var(--glass-blur)) saturate(1.05);\n  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.05);\n}\n\n/* 无边框窗口的 iOS 风格标题栏：可拖动区域与窗口按钮分离。 */\n.titlebar-row {\n  display: flex !important;\n  align-items: center;\n  min-height: 36px;\n  padding: 4px 14px 2px 16px;\n  background: color-mix(in srgb, var(--bg-toolbar) 78%, transparent);\n  border-bottom: 1px solid color-mix(in srgb, var(--line-subtle) 72%, transparent);\n}\n.titlebar-row .window-controls { margin-left: auto; }\n.titlebar-row .window-control { -webkit-app-region: no-drag; }\n\n/* 当前 Toolbar 尚未使用类名时，header 仍然获得同一层级的视觉处理。 */\n.app-content > header {\n  color: var(--text-prim