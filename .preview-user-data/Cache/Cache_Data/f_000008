===============\n   iOS / Apple UI theme system\n   只有日间与夜间两套系统主题；壁纸仍作为 app-wallpaper 的底层视觉保留。\n   ======================================================================== */\n:root {\n  --font-ui: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  --radius-xs: 8px;\n  --radius-sm: 10px;\n  --radius-md: 14px;\n  --radius-lg: 18px;\n  --radius-xl: 24px;\n  --glass-blur: 24px;\n  --motion-fast: 140ms;\n  --motion-normal: 220ms;\n}\n\nhtml, body, button, input, textarea, select {\n  font-family: var(--font-ui);\n}\n\n[data-theme='day'] {\n  color-scheme: light;\n  --bg-primary: #e9eef5;\n  --bg-secondary: rgba(247, 249, 252, .92);\n  --bg-toolbar: rgba(255, 255, 255, .94);\n  --bg-card: #ffffff;\n  --bg-hover: #dfe8f3;\n  --text-primary: #172033;\n  --text-secondary: #506078;\n  --text-tertiary: #738199;\n  --border: rgba(31, 55, 84, .2);\n  --line-subtle: rgba(31, 55, 84, .13);\n  --line-default: rgba(31, 55, 84, .2);\n  --line-strong: rgba(31, 55, 84, .3);\n  --accent: #1769d1;\n  --accent-hover: #0f56b5;\n  --accent-soft: rgba(23, 105, 209, .14);\n  --accent-contrast: #fff;\n  --focus-ring: #1769d1;\n  --focus-shadow: 0 0 0 4px rgba(23, 105, 209, .2);\n  --surface-0: #e9eef5;\n  --surface-1: #f7f9fc;\n  --surface-2: #ffffff;\n  --surface-3: #eef3f8;\n  --surface-elevated: #fff;\n  --glass-bg-light: rgba(255, 255, 255, .7);\n  --glass-bg-medium: rgba(255, 255, 255, .86);\n  --glass-bg: rgba(255, 255, 255, .92);\n  --glass-bg-strong: rgba(255, 255, 255, .98);\n  --glass-border: rgba(31, 55, 84, .16);\n  --glass-highlight: inset 0 1px 0 rgba(255, 255, 255, .98);\n  --shadow: 0 10px 28px rgba(39, 64, 93, .12);\n  --shadow-card: 0 3px 12px rgba(39, 64, 93, .1);\n}\n\n[data-theme='night'] {\n  color-scheme: dark;\n  --bg-primary: #000;\n  --bg-secondary: rgba(28, 28, 30, .72);\n  --bg-toolbar: rgba(28, 28, 30, .78);\n  --bg-card: rgba(28, 28, 30, .88);\n  --bg-hover: rgba(118, 118, 128