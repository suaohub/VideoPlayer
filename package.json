{
  "name": "videoplayer",
  "version": "1.0.0",
  "main": "dist/electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "node electron/build.mjs --watch",
    "dev:start": "wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\" \"npm:dev:start\"",
    "build:vite": "vite build",
    "build:electron": "node electron/build.mjs",
    "build": "npm run build:vite && npm run build:electron",
    "start": "electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
