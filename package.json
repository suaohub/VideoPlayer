{
  "name": "medianest",
  "version": "1.8.4",
  "main": "dist/electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "node electron/build.mjs --watch",
    "dev:start": "wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\" \"npm:dev:start\"",
    "build:vite": "vite build",
    "build:electron": "node electron/build.mjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "build": "npm run build:vite && npm run build:electron",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "pack:dir": "npm run build && electron-builder --dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "本地媒体库管理与播放器",
  "build": {
    "appId": "com.sususu.videoplayer",
    "productName": "MediaNest",
    "directories": {
      "output": "release/v1.8.4"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/electron/osc.lua",
        "to": "osc.lua"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MediaNest"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@11.10.0": true
  }
}
